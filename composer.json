{
    "name": "ariyx/http-client",
    "description": "A modern, feature-rich PHP HTTP client with advanced capabilities including authentication, middleware, retry mechanisms, and comprehensive testing.",
    "type": "library",
    "version": "2.0.0",
    "keywords": ["http", "client", "curl", "api", "rest", "middleware", "authentication"],
    "require": {
        "php": "^8.2",
        "psr/log": "^2.0|^3.0",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "mockery/mockery": "^1.6",
        "monolog/monolog": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ariyx\\HttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ariyx\\HttpClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Armin Malekzadeh",
            "email": "arixologist@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/ariyx/http-client/issues",
        "source": "https://github.com/ariyx/http-client"
    }
}
