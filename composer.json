{
    "name": "ariyx/http-client",
    "description": "A small PSR-18 HTTP client backed by cURL.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Armin Malekzadeh",
            "email": "arixologist@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ariyx/http-client/issues",
        "source": "https://github.com/ariyx/http-client"
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "nyholm/psr7": "^1.8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "provide": {
        "psr/http-client-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Ariyx\\HttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ariyx\\HttpClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs:fix": "php-cs-fixer fix --allow-risky=yes",
        "security": "composer audit",
        "check": [
            "@cs",
            "@analyse",
            "@test",
            "@security"
        ]
    },
    "config": {
        "sort-packages": true
    }
}